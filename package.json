{
	"name": "@typetorch/framework",
	"version": "0.1.0",
	"description": "TypeTorch framework: hot-swappable modules (DI, lifecycle, troves), guarded networking and the in-game dev menu for roblox-ts. Ships inside every artifact.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/typetorch/framework"
	},
	"keywords": ["roblox", "roblox-ts", "hot-reload", "typetorch"],
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": ["out", "!**/*.tsbuildinfo"],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rbxtsc --type package",
		"watch": "rbxtsc --type package -w"
	},
	"peerDependencies": {
		"@flamework/core": "^1.3.2"
	},
	"dependencies": {
		"@rbxts/services": "^1.6.0",
		"@rbxts/t": "^3.2.1",
		"@rbxts/trove": "^1.3.0"
	},
	"devDependencies": {
		"@flamework/core": "^1.3.2",
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@rbxts/types": "^1.0.956",
		"rbxts-transform-debug": "2.2.0",
		"roblox-ts": "^3.0.0",
		"typescript": "5.5.3"
	},
	"overrides": {
		"typescript": "5.5.3"
	}
}
