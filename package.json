{
	"name": "@typetorch/framework",
	"version": "0.3.5",
	"description": "TypeTorch framework for roblox-ts: hot-swappable modules (dependency injection, lifecycle, troves), guarded networking, hot assets and the in-game dev menu. Ships inside every TypeTorch artifact.",
	"license": "MIT",
	"author": "TypeTorch",
	"homepage": "https://github.com/typetorch/framework#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/typetorch/framework.git"
	},
	"bugs": {
		"url": "https://github.com/typetorch/framework/issues"
	},
	"keywords": ["roblox", "roblox-ts", "rbxts", "hot-reload", "hot-swap", "dependency-injection", "typetorch"],
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": ["out", "!**/*.tsbuildinfo"],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rbxtsc --type package",
		"watch": "rbxtsc --type package -w",
		"clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
		"prepublishOnly": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && rbxtsc --type package"
	},
	"peerDependencies": {
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@typetorch/transformer": "^0.2.0",
		"roblox-ts": "^3.0.0"
	},
	"peerDependenciesMeta": {
		"@typetorch/transformer": {
			"optional": true
		}
	},
	"dependencies": {
		"@rbxts/services": "^1.6.0",
		"@rbxts/t": "^3.2.1",
		"@rbxts/trove": "^1.3.0"
	},
	"devDependencies": {
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@rbxts/types": "^1.0.956",
		"rbxts-transform-debug": "2.2.0",
		"roblox-ts": "^3.0.0",
		"typescript": "5.5.3"
	},
	"overrides": {
		"typescript": "5.5.3"
	}
}
